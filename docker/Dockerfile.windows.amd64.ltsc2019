# escape=`

ARG BUILDER_IMAGE=mcr.microsoft.com/windows/servercore@sha256:bea74690d808bba3e6b0d4ba4c599305aea1f66c875f133f1e75855841dcb1d5
ARG RUNTIME_IMAGE=mcr.microsoft.com/windows/nanoserver@sha256:c5980a8cd05a3902130f95fbad5b7db35d21e00183b063ee6bca5c1dcab40ce9
FROM ${BUILDER_IMAGE} AS builder
SHELL ["powershell", "-NoLogo", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Gradle 8.14.7 provides Bouncy Castle 1.85 and Commons Lang 3.18.0.
# Preserve Gradle's expected filenames and align all five Jackson modules with
# the 2.21.8 BOM (annotations uses 2.21).
RUN New-Item -ItemType Directory -Force C:/downloads,C:/tools/jdk,C:/tools/maven,C:/tools/gradle,C:/PowerShell,C:/certificates | Out-Null; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://releases.jfrog.io/artifactory/jfrog-cli/v2/2.129.0/jfrog-cli-windows-amd64/jfrog.exe' -OutFile 'C:/downloads/jfrog.exe'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/downloads/jfrog.exe').Hash.ToLowerInvariant() -ne 'f8fe4d2147369a8d5ecc2ec91cffffefb644999ccc21192d3a22b17c205f7ba1') { throw 'JFrog CLI SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.19%2B10/OpenJDK17U-jdk_x64_windows_hotspot_17.0.19_10.zip' -OutFile 'C:/downloads/jdk.zip'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/downloads/jdk.zip').Hash.ToLowerInvariant() -ne 'b5b235c48adf6a081874b812c630b9f4b5f637b7a5ed18b9174d08a41ec4c235') { throw 'Temurin SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://repo1.maven.org/maven2/org/apache/maven/apache-maven/3.9.11/apache-maven-3.9.11-bin.zip' -OutFile 'C:/downloads/maven.zip'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/downloads/maven.zip').Hash.ToLowerInvariant() -ne '0d7125e8c91097b36edb990ea5934e6c68b4440eef4ea96510a0f6815e7eeadb') { throw 'Maven SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://services.gradle.org/distributions/gradle-8.14.7-bin.zip' -OutFile 'C:/downloads/gradle.zip'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/downloads/gradle.zip').Hash.ToLowerInvariant() -ne '903bfc4bc7622323124054c10f509246212a1902948bdaf26c379cca8735e856') { throw 'Gradle SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/PowerShell/PowerShell/releases/download/v7.4.13/PowerShell-7.4.13-win-x64.zip' -OutFile 'C:/downloads/powershell.zip'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/downloads/powershell.zip').Hash.ToLowerInvariant() -ne '8fb52d2172d285b230c2857a90ba4dd28ecf6477ba4a91f91b6854a647b33b65') { throw 'PowerShell SHA-256 mismatch' }; `
    Expand-Archive "C:/downloads/jdk.zip" -DestinationPath "C:/tools/jdk"; `
    Expand-Archive "C:/downloads/maven.zip" -DestinationPath "C:/tools/maven"; `
    Expand-Archive "C:/downloads/gradle.zip" -DestinationPath "C:/tools/gradle"; `
    Expand-Archive "C:/downloads/powershell.zip" -DestinationPath "C:/PowerShell"; `
    foreach ($Jar in @('jackson-databind', 'jackson-core', 'jackson-annotations', 'jackson-datatype-jdk8', 'jackson-datatype-jsr310')) { `
        if (-not (Test-Path -LiteralPath ('C:/tools/gradle/gradle-8.14.7/lib/' + $Jar + '-2.18.11.jar') -PathType Leaf)) { throw "Unexpected Gradle Jackson layout: $Jar-2.18.11.jar is missing" }; `
    }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-databind/2.21.8/jackson-databind-2.21.8.jar' -OutFile 'C:/tools/gradle/gradle-8.14.7/lib/jackson-databind-2.18.11.jar'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/tools/gradle/gradle-8.14.7/lib/jackson-databind-2.18.11.jar').Hash.ToLowerInvariant() -ne 'ad77f2285717e2f34c319d988b7c85783a47d0b33f33a501d1fcbf196e61bbaa') { throw 'jackson-databind SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-core/2.21.8/jackson-core-2.21.8.jar' -OutFile 'C:/tools/gradle/gradle-8.14.7/lib/jackson-core-2.18.11.jar'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/tools/gradle/gradle-8.14.7/lib/jackson-core-2.18.11.jar').Hash.ToLowerInvariant() -ne '604ef7765013daf5cde192e40bc4c8412c4ca93f4aaf7bf8e9a62fad1e1026bb') { throw 'jackson-core SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-annotations/2.21/jackson-annotations-2.21.jar' -OutFile 'C:/tools/gradle/gradle-8.14.7/lib/jackson-annotations-2.18.11.jar'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/tools/gradle/gradle-8.14.7/lib/jackson-annotations-2.18.11.jar').Hash.ToLowerInvariant() -ne '53ca085f4a150f703f49e1aabd935bd03b43e1ea3d55d135438292af22cef56b') { throw 'jackson-annotations SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://repo1.maven.org/maven2/com/fasterxml/jackson/datatype/jackson-datatype-jdk8/2.21.8/jackson-datatype-jdk8-2.21.8.jar' -OutFile 'C:/tools/gradle/gradle-8.14.7/lib/jackson-datatype-jdk8-2.18.11.jar'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/tools/gradle/gradle-8.14.7/lib/jackson-datatype-jdk8-2.18.11.jar').Hash.ToLowerInvariant() -ne 'a7b796d0ec9d0a8d5cb683a01f2a70638dc968444c66031ed366b0ab70911d84') { throw 'jackson-datatype-jdk8 SHA-256 mismatch' }; `
    Invoke-WebRequest -UseBasicParsing -Uri 'https://repo1.maven.org/maven2/com/fasterxml/jackson/datatype/jackson-datatype-jsr310/2.21.8/jackson-datatype-jsr310-2.21.8.jar' -OutFile 'C:/tools/gradle/gradle-8.14.7/lib/jackson-datatype-jsr310-2.18.11.jar'; `
    if ((Get-FileHash -Algorithm SHA256 'C:/tools/gradle/gradle-8.14.7/lib/jackson-datatype-jsr310-2.18.11.jar').Hash.ToLowerInvariant() -ne '63a0854504aa90ed8f34f891aaa5259f9bd622bac115323559a38abdc1e81632') { throw 'jackson-datatype-jsr310 SHA-256 mismatch' }; `
    certutil -generateSSTFromWU C:/certificates/ca-certificates.sst | Out-Null; `
    Remove-Item C:/downloads/*.zip -Force

# Remove the affected roots present in this pinned Temurin store (CVE-2026-114820).
RUN foreach ($Alias in @('cn_emsign_root_ca__g1,o_emudhra_technologies_limited,ou_emsign_pki,c_in [jdk]', 'cn_emsign_ecc_root_ca__g3,o_emudhra_technologies_limited,ou_emsign_pki,c_in [jdk]')) { `
    & 'C:/tools/jdk/jdk-17.0.19+10/bin/keytool.exe' -delete -cacerts -storepass changeit -noprompt -alias $Alias; `
    if ($LASTEXITCODE -ne 0) { throw "Unable to remove affected Java root: $Alias" }; `
    }

FROM ${RUNTIME_IMAGE}
USER ContainerAdministrator
COPY --from=builder C:/PowerShell C:/PowerShell
SHELL ["C:\\PowerShell\\pwsh.exe", "-NoLogo", "-NonInteractive", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
RUN New-Item -ItemType Directory -Force C:/bin,C:/temp,C:/uploads,C:/users/ContainerAdministrator/.jfrog/security/certs | Out-Null
COPY --from=builder C:/downloads/jfrog.exe C:/bin/jfrog.exe
COPY --from=builder C:/downloads/jfrog.exe C:/bin/jf.exe
COPY --from=builder C:/tools/jdk C:/tools/jdk
COPY --from=builder C:/tools/maven C:/tools/maven
COPY --from=builder C:/tools/gradle C:/tools/gradle
COPY --from=builder C:/certificates C:/certificates
COPY release/windows/amd64/plugin C:/bin/drone-artifactory.exe

ENV JAVA_HOME=C:\\tools\\jdk\\jdk-17.0.19+10 `
    MAVEN_HOME=C:\\tools\\maven\\apache-maven-3.9.11 `
    GRADLE_HOME=C:\\tools\\gradle\\gradle-8.14.7 `
    CI=true `
    GODEBUG=netdns=go `
    PATH="C:\\bin;C:\\PowerShell;C:\\tools\\jdk\\jdk-17.0.19+10\\bin;C:\\tools\\maven\\apache-maven-3.9.11\\bin;C:\\tools\\gradle\\gradle-8.14.7\\bin;C:\\Windows\\System32;C:\\Windows"

LABEL org.opencontainers.image.source="https://github.com/drone-plugins/drone-artifactory" `
      io.harness.windows.build="17763"

ENTRYPOINT ["drone-artifactory"]
