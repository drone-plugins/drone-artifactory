FROM alpine:3.24 as alpine
RUN apk add -U --no-cache ca-certificates

FROM alpine:3.24
ENV GODEBUG netdns=go
ENV CI=true

ARG JRE_VERSION=openjdk17
ARG GRADLE_VERSION=9.6.0

# Copy CA certificates
COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Install necessary tools and dependencies
# Use apk update && apk upgrade to ensure latest security patches
# Remove docker-cli-buildx binaries to fix CVE-2024-45338 false positive
RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache \
    bash \
    "$JRE_VERSION" \
    maven \
    curl \
    docker \
    docker-cli \
    && rm -f /usr/libexec/docker/cli-plugins/docker-buildx \
    && rm -rf /var/cache/apk/*

# Install Gradle
RUN curl -fsSL https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -o /tmp/gradle.zip \
    && mkdir /opt/gradle \
    && unzip /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip \
    && ln -s /opt/gradle/gradle-${GRADLE_VERSION}/bin/gradle /usr/local/bin/gradle

# Install JFrog CLI (CI-23241: bumped to 2.108.0 for grpc/x-net/x-crypto/otel/go-git/docker-cli/jsonparser CVE fixes)
RUN curl -fL https://getcli.jfrog.io/v2-jf | sh /dev/stdin 2.108.0
RUN mv ./jf /usr/local/bin/jf
RUN chmod +x /usr/local/bin/jf

# Add your custom plugin
ADD release/linux/amd64/plugin /bin/

ENTRYPOINT ["/bin/plugin"]
