FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7 AS alpine
RUN apk add -U --no-cache 'ca-certificates>=20261020-r0'

FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1@sha256:290a37c85b4284d2c11fa0778e5da79643d912a1f5a57d6f701b77644503b7e7
ENV GODEBUG netdns=go
ENV CI=true

ARG JRE_VERSION=openjdk-17-default-jdk
ARG GRADLE_VERSION=8.14.7
ARG GRADLE_SHA256=903bfc4bc7622323124054c10f509246212a1902948bdaf26c379cca8735e856

# Copy CA certificates
COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Install necessary tools and dependencies
# Use apk update && apk upgrade to ensure latest security patches
# Remove docker-cli-buildx binaries to fix CVE-2024-45338 false positive
RUN apk update && apk upgrade --no-cache \
    && apk add --no-cache \
    bash \
    "$JRE_VERSION" \
    'java-cacerts>=20261020-r0' \
    maven \
    curl \
    docker-cli \
    && rm -f /usr/libexec/docker/cli-plugins/docker-buildx \
    && rm -rf /var/cache/apk/*

# Preserve native Java CA regeneration, then remove the incident roots.
COPY docker/update-java-trust.sh /etc/ca-certificates/update.d/zz-emudhra-java
RUN chmod 0755 /etc/ca-certificates/update.d/zz-emudhra-java \
    && update-ca-certificates

# Gradle 8.14.7 bundles Bouncy Castle 1.85 and Commons Lang 3.18.0.
# Apply the newer Jackson patches before committing the layer, retaining the
# filenames required by Gradle's module classpaths. Align all five Jackson
# modules with the 2.21.8 BOM (annotations uses 2.21).
RUN mkdir -p /usr/local/bin /opt/gradle \
    && curl -fsSL https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip -o /tmp/gradle.zip \
    && echo "${GRADLE_SHA256}  /tmp/gradle.zip" | sha256sum -c - \
    && unzip /tmp/gradle.zip -d /opt/gradle \
    && rm /tmp/gradle.zip \
    && for jar in jackson-databind jackson-core jackson-annotations jackson-datatype-jdk8 jackson-datatype-jsr310; do \
        test -f "/opt/gradle/gradle-${GRADLE_VERSION}/lib/${jar}-2.18.11.jar" \
            || { echo "Unexpected Gradle Jackson layout: ${jar}-2.18.11.jar is missing" >&2; exit 1; }; \
    done \
    && curl -fsSL https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-databind/2.21.8/jackson-databind-2.21.8.jar -o /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-databind-2.18.11.jar \
    && echo "ad77f2285717e2f34c319d988b7c85783a47d0b33f33a501d1fcbf196e61bbaa  /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-databind-2.18.11.jar" | sha256sum -c - \
    && curl -fsSL https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-core/2.21.8/jackson-core-2.21.8.jar -o /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-core-2.18.11.jar \
    && echo "604ef7765013daf5cde192e40bc4c8412c4ca93f4aaf7bf8e9a62fad1e1026bb  /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-core-2.18.11.jar" | sha256sum -c - \
    && curl -fsSL https://repo1.maven.org/maven2/com/fasterxml/jackson/core/jackson-annotations/2.21/jackson-annotations-2.21.jar -o /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-annotations-2.18.11.jar \
    && echo "53ca085f4a150f703f49e1aabd935bd03b43e1ea3d55d135438292af22cef56b  /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-annotations-2.18.11.jar" | sha256sum -c - \
    && curl -fsSL https://repo1.maven.org/maven2/com/fasterxml/jackson/datatype/jackson-datatype-jdk8/2.21.8/jackson-datatype-jdk8-2.21.8.jar -o /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-datatype-jdk8-2.18.11.jar \
    && echo "a7b796d0ec9d0a8d5cb683a01f2a70638dc968444c66031ed366b0ab70911d84  /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-datatype-jdk8-2.18.11.jar" | sha256sum -c - \
    && curl -fsSL https://repo1.maven.org/maven2/com/fasterxml/jackson/datatype/jackson-datatype-jsr310/2.21.8/jackson-datatype-jsr310-2.21.8.jar -o /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-datatype-jsr310-2.18.11.jar \
    && echo "63a0854504aa90ed8f34f891aaa5259f9bd622bac115323559a38abdc1e81632  /opt/gradle/gradle-${GRADLE_VERSION}/lib/jackson-datatype-jsr310-2.18.11.jar" | sha256sum -c - \
    && ln -s /opt/gradle/gradle-${GRADLE_VERSION}/bin/gradle /usr/local/bin/gradle

# Install JFrog CLI (CVE-2026-39821: bumped to 2.115.0 for golang.org/x/net/idna improper authentication fix)
RUN curl -fL https://getcli.jfrog.io/v2-jf | sh /dev/stdin 2.129.0
RUN mv ./jf /usr/local/bin/jf
RUN chmod +x /usr/local/bin/jf

ADD release/linux/arm64/plugin /usr/local/bin/drone-artifactory
ENTRYPOINT ["drone-artifactory"]
